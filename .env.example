# Copy to .env (never committed) or to ~/.config/agent-readiness-checker/env
# Only a Stripe TEST key is accepted (sk_test_... or rk_test_...). Live keys are refused.
# The value below is a placeholder, not a real key: Stripe will reject it.
STRIPE_SECRET_KEY=sk_test_fake_replace_me
PORT=3000
HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:3000
# Set to 1 when running behind one hosting proxy (Render, Fly, Cloud Run).
TRUST_PROXY_HOPS=0
